Linux 6.11 dropped ctl_table sentinels: register_sysctl() and
register_net_sysctl() now take ARRAY_SIZE() of the table, so the old
trailing {} entry is registered as a nameless node and the whole table is
rejected ("procname is null"). For nss-gmac this fails the probe and no
ethernet interface comes up.

--- a/l2tp/l2tpv2/nss_connmgr_l2tpv2.c
+++ b/l2tp/l2tpv2/nss_connmgr_l2tpv2.c
@@ -905,8 +905,7 @@
 		.maxlen		= L2TP_SYSCTL_STR_LEN_MAX,
 		.mode		= 0644,
 		.proc_handler	= &nss_connmgr_l2tpv2_proc_handler,
-	},
-	{ }
+	}
 };
 
 /*
--- a/match/nss_match_cmd.c
+++ b/match/nss_match_cmd.c
@@ -689,8 +689,7 @@
 		.maxlen                 = sizeof(nss_match_data),
 		.mode			= 0400,
 		.proc_handler		= &nss_match_cmd_procfs_read_help,
-	},
-	{ }
+	}
 };
 
