+++ b/frontends/sfe/ecm_sfe_common.c
@@ -415,8 +415,7 @@
 		.maxlen         = sizeof(int),
 		.mode           = 0644,
 		.proc_handler   = &ecm_sfe_fse_enable_handler,
-	},
-	{}
+	}
 };
 
