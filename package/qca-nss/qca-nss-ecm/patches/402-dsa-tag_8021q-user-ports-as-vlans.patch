 };
 
+#include <linux/if_vlan.h>
+#include <linux/if_bridge.h>
+#include <net/dsa.h>
+#include <linux/dsa/8021q.h>
+
+/*
+ * ecm_interface_dsa_8021q_port()
+ *	The DSA port of a user port whose switch uses the qca-8021q tagger, or NULL
+ */
+static inline struct dsa_port *ecm_interface_dsa_8021q_port(struct net_device *dev)
+{
+#if IS_ENABLED(CONFIG_NET_DSA_TAG_QCA_8021Q)
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return NULL;
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR(dp) || dp->ds->dst->tag_ops->proto != DSA_TAG_PROTO_QCA_8021Q)
+		return NULL;
+
+	return dp;
+#else
+	return NULL;
+#endif
+}
+
+/*
+ * ecm_interface_dsa_8021q_vid()
+ *	A qca-8021q DSA user port reaches the conduit as a plain 802.1Q VLAN: its
+ *	standalone VLAN, or its bridge's VLAN under a VLAN-unaware bridge. Returns
+ *	that VLAN, 0 for any other device, and -1 under a VLAN-aware bridge, where
+ *	the VLAN depends on the flow and is not known here.
+ */
+static inline int ecm_interface_dsa_8021q_vid(struct net_device *dev)
+{
+#if IS_ENABLED(CONFIG_NET_DSA_TAG_QCA_8021Q)
+	struct dsa_port *dp = ecm_interface_dsa_8021q_port(dev);
+	struct net_device *br;
+
+	if (!dp)
+		return 0;
+
+	br = dsa_port_bridge_dev_get(dp);
+	if (!br)
+		return dsa_tag_8021q_standalone_vid(dp);
+
+	if (br_vlan_enabled(br))
+		return -1;
+
+	return dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp));
+#else
+	return 0;
+#endif
+}
+
+/*
+ * ecm_interface_dsa_8021q_conduit()
+ *	The conduit under a qca-8021q DSA user port, or NULL
+ */
+static inline struct net_device *ecm_interface_dsa_8021q_conduit(struct net_device *dev)
+{
+	struct dsa_port *dp = ecm_interface_dsa_8021q_port(dev);
+
+	return dp ? dsa_port_to_conduit(dp) : NULL;
+}
+
+/*
+ * ecm_interface_vlan_egress_qos_mask()
+ *	VLAN priority bits for a VLAN device; none for a DSA user port
+ */
+static inline u16 ecm_interface_vlan_egress_qos_mask(struct net_device *dev, u32 skprio)
+{
+	if (!is_vlan_dev(dev))
+		return 0;
+
+	return vlan_dev_get_egress_qos_mask(dev, skprio);
+}
