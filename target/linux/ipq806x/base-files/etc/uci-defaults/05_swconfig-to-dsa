#!/bin/sh
#
# Boards that moved from swconfig to DSA (qca-8021q tagging) keep their
# network config across sysupgrade. Convert a swconfig config to the DSA
# ports: every switch VLAN device (eth1.1, eth0.2, ...) is replaced by
# the DSA ports that were members of that VLAN. Interfaces, addresses
# and bridge options are kept.
#
# Each switch VLAN is converted one of three ways:
# - every member port is the only port of all its VLANs: the port itself
#   (untagged) or a VLAN upper of it (tagged, e.g. wan.35)
# - untagged ports that are in no other VLAN: the list of those ports
# - anything else (trunks): a VLAN of one VLAN-aware bridge, br-lan.<vid>,
#   with a bridge-vlan section per VLAN. A bridge that only carried such a
#   VLAN is dropped and its users move to br-lan.<vid>.
#
# NSS accelerates the first two. Traffic through a VLAN-aware bridge goes
# through the host. Configs that cannot be converted are moved to
# network.swconfig and the defaults are generated instead.

. /lib/functions.sh

CONF="${CONF:-/etc/config/network}"

# switch port -> DSA port, and CPU port -> conduit
case "${BOARD:-$(board_name)}" in
buffalo,wxr-2533dhp|\
compex,wpq864|\
linksys,ea8500|\
netgear,d7800|\
netgear,r7500|\
netgear,r7500v2|\
zyxel,nbg6817)
	ports="1:lan1 2:lan2 3:lan3 4:lan4 5:wan"
	cpus="0:eth0 6:eth1"
	;;
netgear,r7800|\
netgear,xr450|\
netgear,xr500|\
tplink,c2600|\
tplink,vr2600v)
	ports="1:lan4 2:lan3 3:lan2 4:lan1 5:wan"
	cpus="0:eth0 6:eth1"
	;;
asrock,g10|\
linksys,ea7500-v1|\
nec,wg2600hp|\
tplink,ad7200)
	ports="1:wan 2:lan1 3:lan2 4:lan3 5:lan4"
	cpus="0:eth0 6:eth1"
	;;
nec,wg2600hp3)
	ports="1:wan 2:lan1 3:lan2 4:lan3 5:lan4"
	cpus="0:eth1 6:eth0"
	;;
*)
	exit 0
	;;
esac

grep -q "^config switch_vlan" "$CONF" || exit 0

convert() {
	awk -v ports="$ports" -v cpus="$cpus" -v mapfile="$MAP" '
	function q(s) { gsub(/^'\''|'\''$/, "", s); return s }

	# the value of an option or list line, without quotes
	function val(l) {
		sub(/^[ \t]*[a-z]+[ \t]+[^ \t]+[ \t]+/, "", l)
		return q(l)
	}

	# awk runs END after exit, so the failure has to be remembered
	function fail() { failed = 1; exit 2 }

	function put(key, value) { print "\t" key " '\''" value "'\''" }

	BEGIN {
		n = split(ports, a, " ")
		for (i = 1; i <= n; i++) { split(a[i], b, ":"); dsa[b[1]] = b[2] }
		n = split(cpus, a, " ")
		for (i = 1; i <= n; i++) { split(a[i], b, ":"); cpu[b[1]] = b[2] }
	}

	# first pass: collect the switch VLANs and the bridges
	function collect(    i, n, p, port, tagged) {
		if (stype == "switch_vlan" && svports != "") {
			nv++
			vvid[nv] = (svid != "" ? svid : svlan) + 0
			n = split(svports, p, " ")
			for (i = 1; i <= n; i++) {
				port = p[i]; tagged = sub(/t$/, "", port)
				if (port in cpu) {
					vdev[nv] = cpu[port] (tagged ? "." vvid[nv] : "")
				} else if (port in dsa) {
					port = dsa[port]
					vmem[nv] = vmem[nv] " " port
					if (tagged) vtag[nv, port] = 1
					pcount[port]++
				}
			}
			vmem[nv] = substr(vmem[nv], 2)
		}
		if (stype == "device" && sbtype == "bridge" && sname != "") {
			nb++
			bname[nb] = sname
			bports[nb] = substr(sbports, 2)
			bplain[nb] = splain
		}
	}

	NR == FNR {
		if ($1 == "config") {
			collect()
			stype = $2
			svid = svlan = svports = sname = sbtype = sbports = ""
			splain = 1
			next
		}
		if ($1 == "option" && $2 == "vlan") svlan = val($0)
		if ($1 == "option" && $2 == "vid") svid = val($0)
		if ($1 == "option" && $2 == "ports") svports = val($0)
		if ($1 == "option" && $2 == "name") sname = val($0)
		if ($1 == "option" && $2 == "type") sbtype = val($0)
		if ($1 == "list" && $2 == "ports") sbports = sbports " " val($0)
		if (($1 == "option" || $1 == "list") &&
		    $2 !~ /^(name|type|ports|bridge_empty)$/)
			splain = 0
		next
	}

	# a port that is the only port of every VLAN it is in
	function solo(port,    k) {
		for (k = 1; k <= nv; k++)
			if (index(" " vmem[k] " ", " " port " ") && vmem[k] != port)
				return 0
		return 1
	}

	# DSA ports by name (lan1, lan2, ..., wan)
	function sorted(list,    a, n, i, j, t) {
		n = split(list, a, " ")
		for (i = 2; i <= n; i++)
			for (j = i; j > 1 && a[j - 1] > a[j]; j--) {
				t = a[j]; a[j] = a[j - 1]; a[j - 1] = t
			}
		t = ""
		for (i = 1; i <= n; i++) t = t " " a[i]
		return substr(t, 2)
	}

	function plan(    k, i, n, m, p, x, b, vb, simple, kind) {
		collect()
		for (k = 1; k <= nv; k++) {
			n = split(vmem[k], m, " ")
			kind = "solo"; simple = 1
			for (i = 1; i <= n; i++) {
				if (!solo(m[i])) kind = ""
				if (vtag[k, m[i]] || pcount[m[i]] > 1) simple = 0
			}
			if (kind == "") kind = simple ? "simple" : "trunk"
			vkind[k] = kind

			if (kind == "solo" && n == 1 && vtag[k, m[1]]) {
				# the tagger finds a standalone port from the VID
				if (vvid[k] in uppervid) fail()
				uppervid[vvid[k]] = 1
			}
			if (kind == "solo" && n == 1 && vdev[k] != "")
				map[vdev[k]] = vtag[k, m[1]] ? m[1] "." vvid[k] : m[1]
			else if (kind != "trunk" && vdev[k] != "")
				map[vdev[k]] = sorted(vmem[k])

			if (kind == "trunk") {
				# 3072-4095 belong to the tagger
				if (vvid[k] < 1 || vvid[k] > 3071) fail()
				ntrunk++
				trunks = trunks " " k
				for (i = 1; i <= n; i++) vbport[m[i]] = 1
				if (vdev[k] != "") cmap[vdev[k]] = vvid[k]
			}
		}
		if (!ntrunk) return

		for (k = 1; k <= nv; k++)
			if (vkind[k] == "trunk" && vvid[k] in uppervid) fail()

		# the VLAN-aware bridge: the bridge that held a trunk VLAN,
		# br-lan first, or a new one
		for (b = 1; b <= nb; b++) {
			n = split(bports[b], p, " ")
			for (i = 1; i <= n; i++) if (p[i] in cmap) break
			if (i > n) continue
			if (vb == "" || bname[b] == "br-lan") vb = b
		}
		if (vb != "") {
			VB = bname[vb]
			n = split(bports[vb], p, " ")
			for (i = 1; i <= n; i++) {
				if (p[i] in map) fail()
				if (!(p[i] in cmap)) {
					vbextra = vbextra " " p[i]
					continue
				}
				# two switch VLANs in one bridge cannot be kept apart
				if (VBVID != "") fail()
				VBVID = cmap[p[i]]
			}
		} else {
			VB = "br-lan"
			for (b = 1; b <= nb; b++) if (bname[b] == VB) VB = "br-vlan"
			newvb = 1
		}

		# bridges that only carried a trunk VLAN are dropped
		for (b = 1; b <= nb; b++)
			if (b != vb && bplain[b] && bports[b] in cmap)
				redirect[bname[b]] = VB "." cmap[bports[b]]

		for (x in vbport) vbports = vbports " " x
		vbports = sorted(substr(vbports, 2))
	}

	FNR == 1 { plan() }

	# the name of a device in the DSA config
	function dev(name) {
		if (name in redirect) return redirect[name]
		if (name in cmap) return VB "." cmap[name]
		if (name == VB && VBVID != "") return VB "." VBVID
		if (name in map) return map[name]
		return name
	}

	# second pass: rewrite the config, one section at a time
	function flush(    i, k, n, m, v, rec, skip, isvb) {
		rec = $0
		skip = stype ~ /^switch/ || sname in redirect
		isvb = stype == "device" && sname == VB && !newvb
		for (i = 1; i <= nl && !skip; i++) {
			$0 = line[i]
			v = val($0)
			if ($1 == "list" && $2 == "ports" && isvb && (v in cmap)) {
				n = split(vbports, m, " ")
				for (k = 1; k <= n; k++) put("list ports", m[k])
			} else if ($1 == "list" && $2 == "ports" && (v in map)) {
				n = split(map[v], m, " ")
				for (k = 1; k <= n; k++) put("list ports", m[k])
			} else if (($1 == "option" || $1 == "list") &&
			    $2 ~ /^(device|ifname|name|ports)$/ &&
			    !(isvb && $2 == "name") && dev(v) != v) {
				if ((v in map) && split(map[v], m, " ") != 1) fail()
				put($1 " " $2, dev(v))
			} else {
				print
			}
		}
		nl = 0
		$0 = rec
	}

	$1 == "config" {
		flush()
		stype = $2; sname = ""
	}
	$1 == "option" && $2 == "name" { sname = val($0) }
	{ line[++nl] = $0 }

	# old device -> new device(s), for the other configs
	function maps(    x) {
		if (mapfile == "") return
		for (x in map) print x "\t" map[x] > mapfile
		for (x in cmap) print x "\t" VB "." cmap[x] > mapfile
		for (x in redirect) print x "\t" redirect[x] > mapfile
		if (VBVID != "") print VB "\t" VB "." VBVID > mapfile
	}

	END {
		if (failed) exit 2
		flush()
		maps()
		if (!ntrunk) exit 0

		if (newvb) {
			print ""
			print "config device"
			put("option name", VB)
			put("option type", "bridge")
			n = split(vbports, m, " ")
			for (i = 1; i <= n; i++) put("list ports", m[i])
		}

		n = split(substr(trunks, 2), t, " ")
		for (i = 1; i <= n; i++) {
			k = t[i]
			print ""
			print "config bridge-vlan"
			put("option device", VB)
			put("option vlan", vvid[k])
			c = split(sorted(vmem[k]), m, " ")
			for (j = 1; j <= c; j++)
				put("list ports", m[j] (vtag[k, m[j]] ? ":t" : ":u*"))
			# the other ports of the bridge (e.g. a USB adapter) stay
			# in its VLAN
			if (vvid[k] == VBVID) {
				c = split(substr(vbextra, 2), m, " ")
				for (j = 1; j <= c; j++) put("list ports", m[j] ":u*")
			}
		}
	}
	' "$CONF" "$CONF"
}

# The swconfig LEDs follow switch0 port masks: replace them with the
# board's DSA netdev LEDs
migrate_leds() {
	local cfg key keys name sysfs type device mode

	for cfg in $(uci -q show system | sed -n "s/^system\.\([^.]*\)\.trigger='switch0'$/\1/p"); do
		uci -q delete "system.$cfg"
	done

	. /usr/share/libubox/jshn.sh
	json_load_file /etc/board.json
	json_select led || return 0
	json_get_keys keys
	for key in $keys; do
		json_select "$key"
		json_get_vars name sysfs type device mode
		json_select ..

		[ "$type" = "netdev" ] || continue
		uci -q get "system.led_$key" >/dev/null && continue

		uci -q batch <<-EOF
			set system.led_$key='led'
			set system.led_$key.name='$name'
			set system.led_$key.sysfs='$sysfs'
			set system.led_$key.trigger='netdev'
			set system.led_$key.mode='$mode'
			set system.led_$key.dev='$device'
		EOF
	done
	uci commit system
}

[ -n "$BOARD" ] || migrate_leds

# The other configs may name the old devices (minidlna, sqm, statistics,
# ...): rename them as in the network config. A device that became
# several ports cannot be renamed, only reported.
migrate_others() {
	local file

	for file in "${CONF%/*}"/*; do
		[ -f "$file" ] && [ "$file" != "$CONF" ] || continue
		case "${file##*/}" in
		network*|*-opkg) continue ;;
		esac

		awk -v name="${file##*/}" '
		NR == FNR { split($0, m, "\t"); new[m[1]] = m[2]; next }

		($1 == "option" || $1 == "list") && NF >= 3 {
			line = $0
			q = line; sub(/^[ 	]*[a-z]+[ 	]+[^ 	]+[ 	]+/, "", q)
			head = substr(line, 1, length(line) - length(q))
			quote = substr(q, 1, 1)
			if (quote == "\047" || quote == "\"") v = substr(q, 2, length(q) - 2)
			else { quote = ""; v = q }

			n = split(v, t, " "); out = ""; changed = 0
			for (i = 1; i <= n; i++) {
				if (t[i] in new) {
					if (index(new[t[i]], " ")) {
						print name ": " $2 " " t[i] " became " new[t[i]] ", not renamed" > "/dev/stderr"
					} else {
						t[i] = new[t[i]]; changed = 1
					}
				}
				out = out (i > 1 ? " " : "") t[i]
			}
			if (changed) {
				print name ": " $2 " " v " -> " out > "/dev/stderr"
				print head quote out quote
				touched = 1
				next
			}
		}
		{ print }
		END { exit !touched }
		' "$MAP" "$file" > "$file.dsa" 2>"$MAP.log" && mv "$file.dsa" "$file" || rm -f "$file.dsa"

		while read -r line; do
			logger -t swconfig-to-dsa "$line"
		done < "$MAP.log"
	done
	rm -f "$MAP.log"
}

# Without network.globals.dhcp_default_duid odhcp6c used a DUID-LL of the
# MAC of its interface; 14_network-generate-duid would now pick a new
# DUID-UUID, and the ISP may hand out another IPv6 prefix. Keep the old
# DUID: the DSA port has the MAC the switch VLAN device had. Behind PPPoE
# odhcp6c took the MAC of some other interface, the WAN MAC is a guess.
keep_duid() {
	local dir="${CONF%/*}" cfg="${CONF##*/}" iface dev mac sec

	case "$(uci -q -c "$dir" get "$cfg.globals.dhcp_default_duid")" in
	""|auto) ;;
	*) return 0 ;;
	esac

	iface="$(uci -q -c "$dir" show "$cfg" |
		sed -n "s/^$cfg\.\([^.]*\)\.proto='dhcpv6'$/\1/p" | head -n 1)"
	[ -n "$iface" ] || return 0

	mac="$(uci -q -c "$dir" get "$cfg.$iface.macaddr")"
	dev="$(uci -q -c "$dir" get "$cfg.$iface.device" || uci -q -c "$dir" get "$cfg.$iface.ifname")"
	case "$dev" in
	@*)
		iface="${dev#@}"
		[ -n "$mac" ] || mac="$(uci -q -c "$dir" get "$cfg.$iface.macaddr")"
		dev="$(uci -q -c "$dir" get "$cfg.$iface.device" || uci -q -c "$dir" get "$cfg.$iface.ifname")"
		;;
	esac
	[ -n "$dev" ] || return 0

	if [ -z "$mac" ]; then
		for sec in $(uci -q -c "$dir" show "$cfg" |
			sed -n "s/^$cfg\.\([^.]*\)\.name='$dev'$/\1/p"); do
			[ "$(uci -q -c "$dir" get "$cfg.$sec")" = "device" ] &&
				mac="$(uci -q -c "$dir" get "$cfg.$sec.macaddr")" && break
		done
	fi
	[ -n "$mac" ] || mac="$(cat "/sys/class/net/$dev/address" 2>/dev/null)"

	mac="$(echo "$mac" | tr -d ':' | tr 'A-F' 'a-f')"
	case "$mac" in
	000000000000|*[!0-9a-f]*) return 0 ;;
	esac
	[ ${#mac} -eq 12 ] || return 0

	uci -q -c "$dir" batch <<-EOF
		set $cfg.globals=globals
		set $cfg.globals.dhcp_default_duid=00030001$mac
		commit $cfg
	EOF
	logger -t swconfig-to-dsa "DHCPv6 DUID kept: 00030001$mac (MAC of $dev)"
}

cp "$CONF" "$CONF.swconfig"
MAP="/tmp/swconfig-to-dsa.map"
rm -f "$MAP"

if convert > "$CONF.dsa"; then
	mv "$CONF.dsa" "$CONF"
	logger -t swconfig-to-dsa "network config converted to DSA ports, old config in $CONF.swconfig"
	[ -s "$MAP" ] && migrate_others
	keep_duid
else
	rm -f "$CONF.dsa" "$CONF"
	/bin/config_generate
	logger -t swconfig-to-dsa "switch setup cannot be converted, defaults generated, old config in $CONF.swconfig"
fi
rm -f "$MAP"

exit 0
