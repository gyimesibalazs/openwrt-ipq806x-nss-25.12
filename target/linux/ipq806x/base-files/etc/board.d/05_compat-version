. /lib/functions.sh
. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
	netgear,r7500)
		ucidef_set_compat_version "2.0"
		;;
	linksys,ea7500-v1|\
	linksys,ea8500)
		ucidef_set_compat_version "2.1"
		;;
esac

board_config_flush

exit 0
