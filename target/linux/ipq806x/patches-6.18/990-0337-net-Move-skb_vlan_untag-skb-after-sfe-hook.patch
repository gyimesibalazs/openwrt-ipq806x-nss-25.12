  * @dev: network device
@@ -6044,12 +6041,6 @@ another_round:
 		}
 	}
 
-	if (eth_type_vlan(skb->protocol)) {
-		skb = skb_vlan_untag(skb);
-		if (unlikely(!skb))
-			goto out;
-	}
-
 	if (likely(!fast_tc_filter)) {
 		fast_recv = rcu_dereference(athrs_fast_nat_recv);
 		if (fast_recv) {
@@ -6060,6 +6051,12 @@ another_round:
 		}
 	}
 
+	if (eth_type_vlan(skb->protocol)) {
+		skb = skb_vlan_untag(skb);
+		if (unlikely(!skb))
+			goto out;
+	}
+
 	if (skb_skip_tc_classify(skb))
 		goto skip_classify;
 
@@ -9560,7 +9557,6 @@ void *netdev_lower_dev_get_private(struc
 }
 EXPORT_SYMBOL(netdev_lower_dev_get_private);
 
