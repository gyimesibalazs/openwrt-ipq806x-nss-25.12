+/* DSA puts every tag_8021q VLAN on every CPU port. The switch forwards by
+ * VLAN only, so each frame would then reach both CPU ports. Keep a VLAN
+ * only on the CPU port of its user port, or of the ports of its bridge.
+ */
+static bool qca8k_8021q_cpu_wants(struct qca8k_priv *priv, int cpu, u16 vid)
+{
+	unsigned int num;
+	struct dsa_port *dp;
+
+	for (num = 1; num <= DSA_TAG_8021Q_MAX_NUM_BRIDGES; num++)
+		if (vid == dsa_tag_8021q_bridge_vid(num))
+			break;
+
+	dsa_switch_for_each_user_port(dp, priv->ds) {
+		if (priv->cpu_port_8021q[dp->index] != cpu)
+			continue;
+
+		if (num > DSA_TAG_8021Q_MAX_NUM_BRIDGES) {
+			if (vid == dsa_tag_8021q_standalone_vid(dp))
+				return true;
+		} else if (dsa_port_bridge_num_get(dp) == num) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
+int qca8k_8021q_cpu_sync(struct qca8k_priv *priv, u16 vid)
+{
+	struct dsa_port *dp;
+	int ret;
+
+	dsa_switch_for_each_cpu_port(dp, priv->ds) {
+		int cpu = dp->index;
+
+		if (test_bit(vid, priv->cpu_vids_8021q[cpu ? 1 : 0]) &&
+		    qca8k_8021q_cpu_wants(priv, cpu, vid))
+			ret = qca8k_vlan_add(priv, cpu, vid, false);
+		else
+			ret = qca8k_vlan_del(priv, cpu, vid);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+int qca8k_tag_8021q_vlan_add(struct dsa_switch *ds, int port, u16 vid,
+			     u16 flags)
+{
+	bool untagged = flags & BRIDGE_VLAN_INFO_UNTAGGED;
+	bool pvid = flags & BRIDGE_VLAN_INFO_PVID;
+	struct qca8k_priv *priv = ds->priv;
+	int ret;
+
+	if (dsa_is_cpu_port(ds, port)) {
+		set_bit(vid, priv->cpu_vids_8021q[port ? 1 : 0]);
+		return qca8k_8021q_cpu_sync(priv, vid);
+	}
+
+	ret = qca8k_vlan_add(priv, port, vid, untagged);
+	if (ret || !pvid)
+		return ret;
+
+	priv->pvid_8021q[port] = vid;
+
+	return qca8k_commit_pvid(priv, port);
+}
+
+int qca8k_tag_8021q_vlan_del(struct dsa_switch *ds, int port, u16 vid)
+{
+	struct qca8k_priv *priv = ds->priv;
+
+	if (dsa_is_cpu_port(ds, port)) {
+		clear_bit(vid, priv->cpu_vids_8021q[port ? 1 : 0]);
+		return qca8k_8021q_cpu_sync(priv, vid);
+	}
+
+	return qca8k_vlan_del(priv, port, vid);
+}
