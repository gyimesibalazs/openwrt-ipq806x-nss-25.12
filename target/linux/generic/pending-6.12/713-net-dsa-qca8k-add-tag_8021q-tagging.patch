diff --git a/net/dsa/tag_qca_8021q.c b/net/dsa/tag_qca_8021q.c
new file mode 100644
index 0000000..b73e381
--- /dev/null
+++ b/net/dsa/tag_qca_8021q.c
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-2.0
+/* VLAN-based (tag_8021q) tagging for the Qualcomm Atheros QCA8K switches.
+ *
+ * The QCA8K CPU ports normally carry a 2-byte proprietary header in place
+ * of the EtherType. With this tagger the header is disabled and every port
+ * is identified by a tag_8021q VLAN instead, so the frames on the conduit
+ * are plain 802.1Q.
+ */
+#include <linux/dsa/8021q.h>
+#include <linux/dsa/tag_qca.h>
+
+#include "tag.h"
+#include "tag_8021q.h"
+
+#define QCA_8021Q_NAME "qca-8021q"
+
+static struct sk_buff *qca_8021q_xmit(struct sk_buff *skb,
+				      struct net_device *netdev)
+{
+	struct dsa_port *dp = dsa_user_to_port(netdev);
+	struct qca_8021q_tagger_data *tagger_data = dp->ds->tagger_data;
+	u16 queue_mapping = skb_get_queue_mapping(skb);
+	u16 tx_vid = dsa_tag_8021q_standalone_vid(dp);
+	u8 pcp;
+
+	/* A VLAN of this standalone port is a switch VLAN of its own: send
+	 * it with just that tag
+	 */
+	if (!dp->bridge && skb_vlan_tag_present(skb) &&
+	    READ_ONCE(tagger_data->vid_port[skb_vlan_tag_get_id(skb)]) ==
+	    dp->index + 1)
+		return skb;
+
+	if (skb->offload_fwd_mark) {
+		unsigned int bridge_num = dsa_port_bridge_num_get(dp);
+		struct net_device *br = dsa_port_bridge_dev_get(dp);
+
+		if (br_vlan_enabled(br))
+			return skb;
+
+		tx_vid = dsa_tag_8021q_bridge_vid(bridge_num);
+	}
+
+	pcp = netdev_txq_to_tc(netdev, queue_mapping);
+
+	return dsa_8021q_xmit(skb, netdev, ETH_P_8021Q,
+			      ((pcp << VLAN_PRIO_SHIFT) | tx_vid));
+}
+
+static struct sk_buff *qca_8021q_rcv(struct sk_buff *skb,
+				     struct net_device *netdev)
+{
+	int src_port = -1, switch_id = -1, vbid = -1, vid = -1;
+
+	dsa_8021q_rcv(skb, &src_port, &switch_id, &vbid, &vid);
+
+	/* Not a tag_8021q VLAN: maybe a VLAN of a standalone port */
+	if (src_port == -1 && vbid < 1 && vid > 0) {
+		struct dsa_port *cpu_dp = netdev->dsa_ptr;
+		struct qca_8021q_tagger_data *tagger_data = cpu_dp->ds->tagger_data;
+		u8 port = READ_ONCE(tagger_data->vid_port[vid]);
+
+		if (port) {
+			src_port = port - 1;
+			switch_id = cpu_dp->ds->index;
+		}
+	}
+
+	skb->dev = dsa_tag_8021q_find_user(netdev, src_port, switch_id,
+					   vid, vbid);
+	if (!skb->dev) {
+		dev_warn_ratelimited(&netdev->dev,
+				     "Couldn't decode source port (port %d switch %d vid %d vbid %d proto 0x%04x %pM > %pM)\n",
+				     src_port, switch_id, vid, vbid,
+				     ntohs(eth_hdr(skb)->h_proto),
+				     eth_hdr(skb)->h_source, eth_hdr(skb)->h_dest);
+		return NULL;
+	}
+
+	dsa_default_offload_fwd_mark(skb);
+
+	return skb;
+}
+
+static int qca_8021q_connect(struct dsa_switch *ds)
+{
+	struct qca_8021q_tagger_data *tagger_data;
+
+	tagger_data = kzalloc(sizeof(*tagger_data), GFP_KERNEL);
+	if (!tagger_data)
+		return -ENOMEM;
+
+	ds->tagger_data = tagger_data;
+
+	return 0;
+}
+
+static void qca_8021q_disconnect(struct dsa_switch *ds)
+{
+	kfree(ds->tagger_data);
+	ds->tagger_data = NULL;
+}
+
+static const struct dsa_device_ops qca_8021q_netdev_ops = {
+	.name			= QCA_8021Q_NAME,
+	.proto			= DSA_TAG_PROTO_QCA_8021Q,
+	.xmit			= qca_8021q_xmit,
+	.rcv			= qca_8021q_rcv,
+	.connect		= qca_8021q_connect,
+	.disconnect		= qca_8021q_disconnect,
+	.needed_headroom	= VLAN_HLEN,
+	.promisc_on_conduit	= true,
+};
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("DSA tag driver for QCA8K switches, using VLAN");
+MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_QCA_8021Q, QCA_8021Q_NAME);
+
+module_dsa_tag_driver(qca_8021q_netdev_ops);
